---
import Icone from '../Icone.astro';
---

<dialog id="recherche" class="recherche no-print" aria-label="Rechercher dans les cours">
    <div class="recherche-boite">
        <form method="dialog" class="recherche-champ" role="search">
            <Icone nom="recherche" taille={20} class="text-ink-3 shrink-0"/>
            <input
                    id="recherche-input"
                    type="search"
                    placeholder="Rechercher une notion, une formule…"
                    autocomplete="off"
                    spellcheck="false"
                    aria-controls="recherche-resultats"
                    aria-describedby="recherche-etat"
            />
            <button type="submit" class="recherche-fermer" aria-label="Fermer la recherche">
                <kbd>Échap</kbd>
            </button>
        </form>
        <p id="recherche-etat" class="recherche-etat" aria-live="polite">
            Tape au moins 2 caractères.
        </p>
        <ul id="recherche-resultats" class="recherche-resultats" role="listbox"></ul>
    </div>
</dialog>

<style>
    .recherche {
        margin: 10vh auto auto;
        width: min(42rem, calc(100vw - 1.5rem));
        max-height: 78vh;
        padding: 0;
        border: 1px solid var(--line-strong);
        border-radius: 1rem;
        background: var(--paper);
        color: var(--ink);
        box-shadow: 0 30px 80px -20px oklch(0% 0 0 / 0.45);
    }

    .recherche::backdrop {
        background: oklch(20% 0.02 262 / 0.45);
        backdrop-filter: blur(3px);
    }

    .recherche-boite {
        display: flex;
        flex-direction: column;
        max-height: 78vh;
    }

    .recherche-champ {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid var(--line);
    }

    .recherche-champ input {
        flex: 1;
        min-width: 0;
        background: transparent;
        font-size: 1.05rem;
        color: var(--ink);
        outline: none;
    }

    .recherche-champ input::-webkit-search-cancel-button {
        display: none;
    }

    .recherche-fermer {
        cursor: pointer;
    }

    .recherche-etat {
        font-size: 0.82rem;
        color: var(--ink-3);
        padding: 0.5rem 1.1rem;
    }

    .recherche-etat:empty {
        display: none;
    }

    .recherche-resultats {
        overflow-y: auto;
        padding: 0 0.5rem 0.6rem;
    }

    .recherche-resultats :global(a) {
        display: block;
        padding: 0.65rem 0.75rem;
        border-radius: 0.6rem;
        text-decoration: none;
    }

    .recherche-resultats :global(a:hover),
    .recherche-resultats :global([aria-selected='true'] > a) {
        background: var(--accent-soft);
    }

    .recherche-resultats :global(.r-chemin) {
        font-size: 0.75rem;
        color: var(--ink-3);
        letter-spacing: 0.02em;
    }

    .recherche-resultats :global(.r-titre) {
        font-weight: 600;
        font-family: var(--font-display);
    }

    .recherche-resultats :global(.r-extrait) {
        font-size: 0.87rem;
        color: var(--ink-2);
        margin-top: 0.15rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<script>
    type ResultatPF = {
        url: string;
        excerpt: string;
        meta: { title?: string; cours?: string };
        sub_results?: { url: string; title: string; excerpt: string }[];
    };
    type Pagefind = {
        init: () => Promise<void>;
        debouncedSearch: (
            q: string,
            o?: object,
            ms?: number,
        ) => Promise<{ results: { data: () => Promise<ResultatPF> }[] } | null>;
    };

    const dialogue = document.getElementById('recherche') as HTMLDialogElement;
    const champ = document.getElementById('recherche-input') as HTMLInputElement;
    const liste = document.getElementById('recherche-resultats') as HTMLUListElement;
    const etat = document.getElementById('recherche-etat') as HTMLParagraphElement;
    let pagefind: Pagefind | null = null;
    let selection = -1;

    async function charger(): Promise<Pagefind | null> {
        if (pagefind) return pagefind;
        try {
            const url = '/pagefind/pagefind.js';
            pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
            await pagefind.init();
        } catch {
            etat.textContent =
                "L'index de recherche est généré au build (npm run build puis npm run preview).";
        }
        return pagefind;
    }

    function ouvrir() {
        if (dialogue.open) return;
        dialogue.showModal();
        champ.select();
        charger();
    }

    function echapper(s: string) {
        return s.replace(/[&<>"]/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'})[c]!);
    }

    function choisir(i: number) {
        const items = [...liste.querySelectorAll('li')];
        if (!items.length) return;
        selection = (i + items.length) % items.length;
        items.forEach((li, k) => li.setAttribute('aria-selected', String(k === selection)));
        items[selection].scrollIntoView({block: 'nearest'});
    }

    async function chercher() {
        const q = champ.value.trim();
        if (q.length < 2) {
            liste.innerHTML = '';
            etat.textContent = 'Tape au moins 2 caractères.';
            return;
        }
        const pf = await charger();
        if (!pf) return;
        const recherche = await pf.debouncedSearch(q, {}, 150);
        if (!recherche) return; // requête remplacée par une plus récente
        const donnees = await Promise.all(recherche.results.slice(0, 12).map((r) => r.data()));
        etat.textContent = donnees.length
            ? `${recherche.results.length} résultat${recherche.results.length > 1 ? 's' : ''}`
            : 'Aucun résultat.';
        liste.innerHTML = donnees
            .map((d) => {
                // Pagefind découpe la page par titres : on pointe vers la section la plus pertinente
                const sous = d.sub_results?.find((s) => s.url.includes('#')) ?? null;
                const url = sous?.url ?? d.url;
                const titre = sous && sous.title !== d.meta.title ? `${d.meta.title} › ${sous.title}` : d.meta.title;
                return `<li role="option" aria-selected="false"><a href="${echapper(url)}">
          <div class="r-chemin">${echapper(d.meta.cours ?? '')}</div>
          <div class="r-titre">${echapper(titre ?? url)}</div>
          <div class="r-extrait">${sous?.excerpt ?? d.excerpt}</div></a></li>`;
            })
            .join('');
        selection = -1;
        if (donnees.length) choisir(0);
    }

    champ.addEventListener('input', chercher);
    champ.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            choisir(selection + 1);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            choisir(selection - 1);
        } else if (e.key === 'Enter') {
            const lien = liste.querySelector<HTMLAnchorElement>('[aria-selected="true"] a');
            if (lien) {
                e.preventDefault();
                location.href = lien.href;
            }
        }
    });
    dialogue.addEventListener('click', (e) => {
        if (e.target === dialogue) dialogue.close();
    });
    liste.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) dialogue.close();
    });

    document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            ouvrir();
        } else if (e.key === '/' && !(e.target as HTMLElement).closest('input, textarea, [contenteditable]')) {
            e.preventDefault();
            ouvrir();
        }
    });
    document.querySelectorAll('[data-ouvrir-recherche]').forEach((b) => b.addEventListener('click', ouvrir));
</script>
