---
/** Passage à compléter (figure trop complexe, page illisible…). Visible pour ne pas l'oublier. */
interface Props {
    page?: number
}
---
<aside class="no-print my-6 rounded-lg border-2 border-dashed border-line-strong px-4 py-3 text-sm text-ink-2"
       data-pagefind-ignore>
    <strong class="font-mono text-xs uppercase tracking-wider text-margin">TODO{Astro.props.page && ` · page ${Astro.props.page}`}</strong>
    <div class="mt-1">
        <slot/>
    </div>
</aside>
